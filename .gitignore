.venv/
__pycache__/
*.py[cod]

# Данные соревнования и кэш признаков — не в репозиторий
data/

# Веса и сабмиты не коммитим, а вот журналы — обязательно:
# по ним команда сравнивает эксперименты, а жюри проверяет воспроизводимость.
models/*
!models/experiments.csv
# Журнал перебора гиперпараметров: те же права, что у общего журнала —
# это результат, а не промежуточный файл.
!models/lgb_grid.csv
submissions/*
!submissions/log.csv

# CatBoost пишет логи обучения в рабочую папку
catboost_info/

.ipynb_checkpoints/
.idea/
.vscode/

# файлы передачи между треками — уходят напрямую, не через git
handoff_*.npz
